# Copy to .env and adjust.

# Image tag after `docker load -i <csrx-image>.tgz`. This MUST match exactly,
# including the build number — Juniper tags are like 26.2R1.7, not 26.2R1.
# Check with:  docker images | grep csrx
# A mismatch makes Docker attempt a registry pull and report "pull access
# denied", which is misleading; there is no cSRX image in any public registry.
CSRX_IMAGE=csrx:26.2R1.7

# Identifies this run in both flows.csv and intents.jsonl. Change it per run so
# runs stay comparable rather than merging into one another.
RUN_ID=stage0-dev

# Same seed + same scenario = same traffic. This is the reproducibility
# contract that makes clean-vs-attack comparison meaningful later.
SEED=1337

WORKER_COUNT=3
DURATION_S=300

TARGET_HOST=www.example-corp.internal

# ---- Network addressing -------------------------------------------------
# Change these if they collide with an existing docker network or host route.
# Check first:
#   docker network ls -q | xargs -n1 docker network inspect \
#     --format '{{.Name}} {{range .IPAM.Config}}{{.Subnet}}{{end}}'
#   ip -br route
#
# TRUST_PREFIX is the first TWO octets and expands to <prefix>.0.0/16. The
# worker allocator uses the third octet to scale past 254 workers, so keep it
# a /16. The other two are three octets and expand to <prefix>.0/24.
# Set false to give the MANAGEMENT bridge egress, so cSRX can download the
# AppID signature database from signatures.juniper.net. Trust and untrust stay
# internal regardless, so the simulated data plane never reaches the real
# internet. Changing this recreates the network — run `make down` first.
MGMT_INTERNAL=true

TRUST_PREFIX=10.20
MGMT_PREFIX=172.30.0
UNTRUST_PREFIX=203.0.113
