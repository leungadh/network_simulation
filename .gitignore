# ---- Never commit these ----------------------------------------------
# cSRX is licensed Juniper software. The image and any licence keys must
# not go into a repo, public or private.
*.tgz
*.tar.gz
csrx-*.img
*.lic
licen[cs]e-key*
junos-*.tgz

# Application signature packages — licensed Juniper software, large.
lab/csrx/signatures/*
!lab/csrx/signatures/README.md

# Secrets and local config
.env
*.pem

# Generated PKI. `make pki` recreates it; committing a CA private key is
# a bad habit even for a lab CA.
**/pki/*.crt
**/pki/*.key
**/pki/*.srl

# Run outputs — regenerated every run, and they get large fast.
**/out/*
!**/out/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp

# Bridge scratch
_to_delete/

# Pre-rename backup copies of the lab. Keeping one is fine; committing it is
# not — a stale duplicate declares the same subnets as lab/, so bringing it up
# collides with the live lab ("Pool overlaps with other one on this address
# space"). Git history is the real backup: the commit before the rename has
# everything under stage0/.
stage0/
*-backup/
*.bak/
